---
// Gabarit unique du site (direction « Mosaïque ») : en-tête flottant, pied de
// page sombre avec le contact, métadonnées de partage et données structurées.
import '@fontsource-variable/archivo/wdth.css';
import '../styles/site.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site.js';
import { url } from '../lib/url.js';
import { typo } from '../lib/typo.js';

interface Props {
  title?: string;
  description?: string;
  /** Image de partage (URL absolue ou chemin interne). Par défaut : og.png. */
  image?: string;
  type?: 'website' | 'article';
  /** Pas d'URL canonique (page 404). */
  noCanonical?: boolean;
  /** Page d'accueil : liens du menu vers les ancres de la page. */
  home?: boolean;
  /** Visuel d'ouverture clair : menu en encre au lieu de blanc. */
  lightHero?: boolean;
}

const { title, image, type = 'website', noCanonical = false, home = false, lightHero = false } = Astro.props;
const description = typo(Astro.props.description ?? site.description);
const fullTitle = title ? `${title} · ${site.name}` : site.title;
const canonical = Astro.site && !noCanonical ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(image ?? url('og.png'), Astro.site).href : undefined;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: 'Élève-ingénieur',
  affiliation: { '@type': 'CollegeOrUniversity', name: 'SIGMA Clermont' },
  url: Astro.site ? new URL(url(''), Astro.site).href : undefined,
  sameAs: [site.contact.linkedin],
};
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#0d0d0f" />
    {!site.indexable && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href={url('favicon.ico')} sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <Header home={home} ink={lightHero} />
    <main id="contenu">
      <slot />
    </main>
    <Footer>
      <slot name="credits" />
    </Footer>

    <dialog class="zoom" aria-label="Image agrandie">
      <button class="zoom__close" type="button">Fermer</button>
      <img alt="" />
    </dialog>

    <script>
      // En-tête transparent sur le visuel d'ouverture ([data-hero]), opaque ensuite.
      // Sans visuel d'ouverture, il reste opaque.
      const header = document.querySelector<HTMLElement>('[data-header]');
      const hero = document.querySelector<HTMLElement>('[data-hero]');
      // Le seuil est fixe (64 px sous le haut de l'écran) : il ne dépend pas de la
      // hauteur de l'en-tête, qui change justement avec son état.
      if (header && hero) {
        new IntersectionObserver(([e]) => header.classList.toggle('is-solid', !e.isIntersecting), {
          rootMargin: '-64px 0px 0px 0px',
        }).observe(hero);
      }

      // Agrandissement des figures (dialog natif, Échap pour fermer).
      const dialog = document.querySelector<HTMLDialogElement>('dialog.zoom');
      const zoomImg = dialog?.querySelector('img');
      document.addEventListener('click', (event) => {
        const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('a[data-zoom]');
        if (!link || !dialog || !zoomImg) return;
        const me = event as MouseEvent;
        if (me.metaKey || me.ctrlKey || me.shiftKey || me.button !== 0) return;
        event.preventDefault();
        zoomImg.src = link.href;
        zoomImg.alt = link.dataset.zoomAlt ?? '';
        dialog.showModal();
      });
      dialog?.addEventListener('click', () => dialog.close());
      dialog?.addEventListener('close', () => zoomImg?.removeAttribute('src'));

      // Boucles vidéo des études de cas : lecture seulement à l'écran, jamais si
      // l'on a demandé à réduire les animations (on affiche alors les contrôles).
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const videos = document.querySelectorAll<HTMLVideoElement>('video[data-loop]');
      if (reduce || !('IntersectionObserver' in window)) {
        videos.forEach((v) => (v.controls = true));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              const v = entry.target as HTMLVideoElement;
              if (entry.isIntersecting) {
                v.preload = 'auto';
                v.play().catch(() => (v.controls = true));
              } else {
                v.pause();
              }
            }
          },
          { threshold: 0.35 },
        );
        videos.forEach((v) => io.observe(v));
      }
    </script>
  </body>
</html>
