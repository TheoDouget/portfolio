---
// Globe interactif du parcours (inspiré du « Career Globe » de katieheinemann.space).
// Rendu canvas léger avec d3-geo (projection orthographique), sans WebGL.
// La liste des lieux reste lisible et utilisable sans le canvas.
interface Place {
  name: string;
  lon: number;
  lat: number;
  when: string;
  what: string;
  href?: string;
}
interface Props {
  places: Place[];
}
const { places } = Astro.props;
---

<div class="globe" data-globe data-places={JSON.stringify(places)}>
  <div class="globe__stage">
    <canvas class="globe__canvas" aria-hidden="true"></canvas>
  </div>
  <ol class="globe__list">
    {
      places.map((p, i) => (
        <li>
          <button type="button" data-place={i}>
            <span class="globe__when">{p.when}</span>
            <span class="globe__name">{p.name}</span>
            <span class="globe__what">{p.what}</span>
          </button>
        </li>
      ))
    }
  </ol>
</div>

<script>
  import { geoOrthographic, geoPath, geoGraticule10, geoDistance } from 'd3-geo';
  import { feature } from 'topojson-client';
  import landTopo from 'world-atlas/land-110m.json';

  type Place = { name: string; lon: number; lat: number; when: string; what: string };

  const land = feature(landTopo as any, (landTopo as any).objects.land);
  const graticule = geoGraticule10();
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-globe]').forEach((root) => {
    const places: Place[] = JSON.parse(root.dataset.places ?? '[]');
    const canvas = root.querySelector<HTMLCanvasElement>('canvas')!;
    const ctx = canvas.getContext('2d')!;
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('[data-place]')];
    const projection = geoOrthographic().clipAngle(90).precision(0.4);
    const path = geoPath(projection, ctx);

    let rot: [number, number] = [-20, -32];
    let size = 0;
    let selected = -1;
    let dragging = false;
    let idleUntil = 0;
    let anim: { from: [number, number]; to: [number, number]; t0: number } | null = null;

    const resize = () => {
      const r = canvas.parentElement!.getBoundingClientRect();
      size = Math.max(200, Math.min(r.width, r.height || r.width));
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = size * dpr;
      canvas.height = size * dpr;
      canvas.style.width = `${size}px`;
      canvas.style.height = `${size}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      projection.translate([size / 2, size / 2]).scale(size / 2 - 6);
      draw();
    };

    const draw = () => {
      projection.rotate(rot);
      ctx.clearRect(0, 0, size, size);
      const c = size / 2;
      const r = size / 2 - 6;
      // halo
      const halo = ctx.createRadialGradient(c, c, r * 0.9, c, c, r * 1.08);
      halo.addColorStop(0, 'rgba(120,170,255,0.18)');
      halo.addColorStop(1, 'rgba(120,170,255,0)');
      ctx.fillStyle = halo;
      ctx.beginPath();
      ctx.arc(c, c, r * 1.08, 0, Math.PI * 2);
      ctx.fill();
      // océan
      const ocean = ctx.createRadialGradient(c - r * 0.35, c - r * 0.4, r * 0.1, c, c, r);
      ocean.addColorStop(0, '#1d3a63');
      ocean.addColorStop(1, '#07111f');
      ctx.fillStyle = ocean;
      ctx.beginPath();
      path({ type: 'Sphere' } as any);
      ctx.fill();
      // graticule
      ctx.strokeStyle = 'rgba(255,255,255,0.07)';
      ctx.lineWidth = 0.6;
      ctx.beginPath();
      path(graticule);
      ctx.stroke();
      // terres
      ctx.fillStyle = '#d8dde4';
      ctx.beginPath();
      path(land as any);
      ctx.fill();
      // points
      const center: [number, number] = [-rot[0], -rot[1]];
      places.forEach((p, i) => {
        if (geoDistance([p.lon, p.lat], center) > Math.PI / 2 - 0.08) return;
        const xy = projection([p.lon, p.lat]);
        if (!xy) return;
        const isSel = i === selected;
        ctx.fillStyle = '#f5a524';
        ctx.beginPath();
        ctx.arc(xy[0], xy[1], isSel ? 5.5 : 3.6, 0, Math.PI * 2);
        ctx.fill();
        if (isSel) {
          ctx.strokeStyle = 'rgba(245,165,36,0.55)';
          ctx.lineWidth = 2;
          ctx.beginPath();
          ctx.arc(xy[0], xy[1], 11, 0, Math.PI * 2);
          ctx.stroke();
          ctx.font = '600 12px "Space Grotesk Variable", system-ui, sans-serif';
          ctx.fillStyle = '#ffffff';
          ctx.shadowColor = 'rgba(0,0,0,0.6)';
          ctx.shadowBlur = 6;
          ctx.fillText(p.name.toUpperCase(), xy[0] + 14, xy[1] + 4);
          ctx.shadowBlur = 0;
        }
      });
    };

    const ease = (t: number) => 1 - Math.pow(1 - t, 3);
    const tick = (now: number) => {
      if (anim) {
        const t = Math.min(1, (now - anim.t0) / (reduce ? 1 : 1100));
        const k = ease(t);
        rot = [anim.from[0] + (anim.to[0] - anim.from[0]) * k, anim.from[1] + (anim.to[1] - anim.from[1]) * k];
        if (t >= 1) anim = null;
        draw();
      } else if (!reduce && !dragging && now > idleUntil) {
        rot = [rot[0] + 0.08, rot[1]];
        draw();
      }
      requestAnimationFrame(tick);
    };

    const select = (i: number) => {
      selected = i;
      buttons.forEach((b, j) => b.toggleAttribute('aria-current', j === i));
      const p = places[i];
      let target0 = -p.lon;
      while (target0 - rot[0] > 180) target0 -= 360;
      while (target0 - rot[0] < -180) target0 += 360;
      anim = { from: [...rot] as [number, number], to: [target0, -Math.max(-55, Math.min(55, p.lat)) + 8], t0: performance.now() };
      idleUntil = performance.now() + 7000;
    };

    buttons.forEach((b, i) => b.addEventListener('click', () => select(i)));

    let last: [number, number] | null = null;
    canvas.addEventListener('pointerdown', (e) => {
      dragging = true;
      last = [e.clientX, e.clientY];
      canvas.setPointerCapture(e.pointerId);
    });
    canvas.addEventListener('pointermove', (e) => {
      if (!dragging || !last) return;
      const k = 160 / size;
      rot = [rot[0] + (e.clientX - last[0]) * k, Math.max(-70, Math.min(70, rot[1] - (e.clientY - last[1]) * k))];
      last = [e.clientX, e.clientY];
      anim = null;
      draw();
    });
    const end = () => {
      dragging = false;
      last = null;
      idleUntil = performance.now() + 4000;
    };
    canvas.addEventListener('pointerup', end);
    canvas.addEventListener('pointercancel', end);

    new ResizeObserver(resize).observe(canvas.parentElement!);
    resize();
    select(places.findIndex((p) => /Clermont/.test(p.name)));
    requestAnimationFrame(tick);
  });
</script>
