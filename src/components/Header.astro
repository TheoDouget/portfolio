---
// En-tête flottant : blanc sur le visuel d'ouverture, opaque au défilement.
// Sur l'accueil, les liens pointent vers les sections de la page ; ailleurs,
// vers les mêmes sections de l'accueil.
import { site } from '../data/site.js';
import { url } from '../lib/url.js';

interface Props {
  home?: boolean;
  /** Menu en encre sur un visuel d'ouverture clair. */
  ink?: boolean;
}
const { home = false, ink = false } = Astro.props;
const to = (id: string) => (home ? `#${id}` : `${url('')}#${id}`);
const links = [
  { href: to('bio'), label: 'Bio', cls: 'hide-sm' },
  { href: home ? '#projets' : url('projets/'), label: 'Projets' },
  { href: to('interculturel'), label: 'Interculturel' },
  { href: '#contact', label: 'Contact' },
];
---

<header class:list={['m-header', { 'm-header--ink': ink }]} data-header>
  <nav class="m-nav" aria-label="Navigation principale">
    {links.map((l) => <a class={l.cls} href={l.href}>{l.label}</a>)}
  </nav>
  <a class="m-mono wide" href={home ? '#top' : url('')}>
    TD<span class="sr-only">{home ? ' — haut de page' : ` — ${site.name}, accueil`}</span>
  </a>
  <nav class="m-nav m-nav--end" aria-label="Liens externes">
    <a class="hide-sm" href={site.contact.linkedin} target="_blank" rel="noopener">LinkedIn<span class="sr-only"> (nouvel onglet)</span></a>
    <a href={site.contact.cv} target="_blank" rel="noopener">CV<span class="sr-only"> (nouvel onglet)</span></a>
  </nav>
</header>
