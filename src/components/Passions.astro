---
// Passions : les sports que Théo pratique. Chaque carte montre une vraie photo
// passée au filtre « trait » (contours noirs sur blanc, comme l'en-tête A).
// Photos libres (licence Unsplash), créditées sous la section ; ce ne sont pas
// des photos de Théo. À remplacer par les siennes quand il les envoie, avec le
// même traitement ffmpeg : scale=1600:-2,format=gray,gblur=sigma=2,
// edgedetect=low=0.12:high=0.30,dilation,negate (sigma 1,4 et 0.07/0.18 pour
// une photo moins chargée en détails).
import { Picture } from 'astro:assets';
import { typoDeep } from '../lib/typo.js';
import ski from '../assets/passions/ski.png';
import randonnee from '../assets/passions/randonnee.png';
import velo from '../assets/passions/velo.png';

const items = typoDeep([
  { t: 'Ski alpin', pos: '38% 50%' },
  { t: 'Randonnée', pos: '50% 50%' },
  { t: 'Vélo', pos: '50% 50%' },
]).map((it, i) => ({ ...it, img: [ski, randonnee, velo][i] }));

const credits = [
  { name: 'JResnick215 pour Glade Optics', url: 'https://unsplash.com/photos/DumeSMuXgao' },
  { name: 'Chris Hayashi', url: 'https://unsplash.com/photos/man-standing-on-cliff-facing-mountain-range-gbaeHydpgtE' },
  { name: 'Azmil Murad', url: 'https://unsplash.com/photos/cyclist-on-a-mountain-road-with-glaciers-behind-2KD4IY-L9-o' },
];
---

<section class="m-passions" id="passions" aria-labelledby="passions-titre">
  <div class="m-wrap">
    <div class="m-sec-head">
      <h2 class="wide" id="passions-titre">Passions</h2>
      <p>En dehors des projets, je fais du ski, de la randonnée et du vélo.</p>
    </div>
    <ul class="m-passions__list">
      {
        items.map((it, n) => (
          <li class="m-passion">
            <Picture
              class="m-passion__art"
              src={it.img}
              alt=""
              formats={['avif', 'webp']}
              fallbackFormat="png"
              widths={[480, 800, 1200]}
              sizes="(min-width: 48rem) 30vw, 100vw"
              loading="lazy"
              style={`object-position:${it.pos}`}
            />
            <span class="m-passion__n">{String(n + 1).padStart(2, '0')}</span>
            <h3 class="wide">{it.t}</h3>
          </li>
        ))
      }
    </ul>
    <p class="m-passions__credit">
      Illustrations : photos de{' '}
      {
        credits.map((c, i) => (
          <>
            {i > 0 && (i === credits.length - 1 ? ' et ' : ', ')}
            <a href={c.url} target="_blank" rel="noopener">
              {c.name}
              <span class="sr-only"> (nouvel onglet)</span>
            </a>
          </>
        ))
      }{' '}
      (Unsplash), redessinées au trait.
    </p>
  </div>
</section>
