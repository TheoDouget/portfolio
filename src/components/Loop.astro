---
// Courte boucle vidéo muette (fichiers dans public/). Elle ne se charge et ne
// se lance que quand elle entre à l'écran ; avec « réduire les animations »,
// elle reste sur son image et affiche les contrôles.
interface Props {
  /** Chemin depuis public/, sans slash initial, ex. « media/drone/x.mp4 ». */
  src: string;
  poster: string;
  caption?: string;
  label: string;
  wide?: boolean;
  width?: number;
  height?: number;
}
import { typo } from '../lib/typo.js';
const { src, poster, wide = true, width = 1280, height = 720 } = Astro.props;
const label = typo(Astro.props.label);
const caption = Astro.props.caption ? typo(Astro.props.caption) : undefined;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<figure class:list={['fig', 'fig--video', { 'fig--wide': wide }]}>
  <video
    class="loop"
    src={`${base}/${src}`}
    poster={`${base}/${poster}`}
    width={width}
    height={height}
    muted
    loop
    playsinline
    preload="none"
    aria-label={label}
    data-loop
  ></video>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
