---
import { site } from '../data/site.js';
import { isExternal } from '../lib/url.js';
---

<ul class="list">
  {
    site.recognition.map((r) => (
      <li>
        <span class="meta">{r.date}</span>
        <span class="list__main">
          {r.url && isExternal(r.url) ? (
            <a href={r.url} rel="noopener" target="_blank">
              {r.title}
              <span class="sr-only"> (nouvel onglet)</span>
            </a>
          ) : (
            r.title
          )}
        </span>
        <span class="meta list__aside">{r.source}</span>
      </li>
    ))
  }
</ul>
