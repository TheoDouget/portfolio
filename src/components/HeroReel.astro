---
// En-tête plein écran de la proposition C : une suite de courtes vidéos de ce
// qui fait rêver Théo (espace, robotique, automobile, IA). Chaque vidéo entre
// par bandes verticales décalées, avec un léger zoom arrière, et la couleur
// d'accent suit la vidéo affichée. Le nom (slot) est posé par-dessus, sur un
// voile sombre. Les vidéos ne sont chargées qu'une à la fois, juste avant leur
// tour (720p sur mobile ou en mode économie de données, 1080p sinon).
import { url } from '../lib/url.js';
import { typo } from '../lib/typo.js';

interface Slide {
  video: { hd: string; sd: string; poster: string };
  k: string; // thème
  t: string; // ce que montre la vidéo
  credit: string; // auteur et licence, affichés sous la légende
  source: string; // page d'origine de la vidéo
  accent: string;
  pos?: string;
}
interface Props {
  slides: Slide[];
  duration?: number;
  eyebrow?: string;
  /** « trait » : versions dessinées des vidéos (traits noirs sur papier blanc) ;
   *  « noir » : filtre noir et blanc contrasté appliqué aux vidéos d'origine. */
  variant?: 'video' | 'trait' | 'noir';
}
const { duration = 5000, eyebrow = 'Ce qui me fait rêver', variant = 'video' } = Astro.props;
const trait = variant === 'trait';
const noir = variant === 'noir';
// Version « trait » : mêmes extraits, rendus en dessin dans media/hero/trait/,
// et une seule couleur, l'encre.
const slides = trait
  ? Astro.props.slides.map((s) => ({
      ...s,
      accent: '#0d0d0f',
      video: Object.fromEntries(Object.entries(s.video).map(([k, v]) => [k, v.replace('media/hero/', 'media/hero/trait/')])) as Slide['video'],
    }))
  : noir
    ? Astro.props.slides.map((s) => ({ ...s, accent: '#ffffff' }))
    : Astro.props.slides;
const first = slides[0];
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class:list={['reel', { 'reel--trait': trait, 'reel--noir': noir }]} id="top" aria-label="Présentation" data-reel data-hero style={`--dur:${duration}ms; --accent:${first.accent}`}>
  <div class="reel__slides" aria-hidden="true">
    {
      slides.map((s, i) => (
        <figure
          class:list={['reel__slide', { 'is-on': i === 0 }]}
          data-k={typo(s.k)}
          data-t={typo(s.t)}
          data-credit={typo(s.credit)}
          data-source={s.source}
          data-accent={s.accent}
          style={s.pos ? `--pos:${s.pos}` : undefined}
        >
          <video
            muted
            playsinline
            loop
            preload="none"
            tabindex="-1"
            disablepictureinpicture
            disableremoteplayback
            data-hd={url(s.video.hd)}
            data-sd={url(s.video.sd)}
            data-poster={url(s.video.poster)}
            poster={i === 0 ? url(s.video.poster) : undefined}
          />
        </figure>
      ))
    }
  </div>
  <div class="reel__scrim" aria-hidden="true"></div>

  <div class="reel__content">
    <slot />
  </div>

  <div class="reel__bar">
    <div class="reel__now" data-reel-now>
      <span class="reel__count"><span data-reel-n>01</span> / {pad(slides.length)}<span class="reel__eyebrow"> · {typo(eyebrow)}</span></span>
      <span class="reel__k" data-reel-k>{typo(first.k)}</span>
      <span class="reel__t" data-reel-t>{typo(first.t)}</span>
      <a class="reel__credit" href={first.source} target="_blank" rel="noopener" data-reel-credit>
        Vidéo&nbsp;: <span data-reel-credit-text>{typo(first.credit)}</span><span class="sr-only"> (source, nouvel onglet)</span>
      </a>
    </div>
    <div class="reel__controls">
      <div class="reel__dots" role="group" aria-label="Choisir une vidéo">
        {
          slides.map((s, i) => (
            <button type="button" class:list={['reel__dot', { 'is-on': i === 0 }]} aria-label={typo(`Vidéo ${i + 1} : ${s.t}`)} aria-current={i === 0 ? 'true' : undefined}>
              <i />
            </button>
          ))
        }
      </div>
      <button type="button" class="reel__pause" data-reel-pause aria-label="Mettre les vidéos en pause">
        <svg viewBox="0 0 16 16" aria-hidden="true" class="i-pause"><rect x="3" y="2" width="3.5" height="12" rx="1"></rect><rect x="9.5" y="2" width="3.5" height="12" rx="1"></rect></svg>
        <svg viewBox="0 0 16 16" aria-hidden="true" class="i-play"><path d="M4 2.5v11l9.5-5.5z"></path></svg>
      </button>
    </div>
  </div>
</section>

<style>
  @property --accent {
    syntax: '<color>';
    inherits: true;
    initial-value: #ffffff;
  }
  .reel {
    position: relative;
    height: 100vh;
    height: 100svh;
    min-height: 34rem;
    overflow: hidden;
    background: #0d0d0f;
    color: #fff;
    isolation: isolate;
    transition: --accent 900ms ease;
  }
  .reel__slides,
  .reel__slide,
  .reel__scrim {
    position: absolute;
    inset: 0;
  }
  .reel__slide {
    margin: 0;
    overflow: hidden;
    visibility: hidden;
    z-index: 0;
    background: #0d0d0f;
  }
  .reel__slide.is-on {
    visibility: visible;
    z-index: 1;
  }
  .reel__slide.is-in {
    visibility: visible;
    z-index: 2;
  }
  .reel__slide video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--pos, 50% 50%);
    transform: scale(1.04);
    will-change: transform;
  }
  .reel__slide.is-on video,
  .reel__slide.is-in video {
    animation: reel-drift calc(var(--dur) + 1400ms) cubic-bezier(0.16, 0.7, 0.2, 1) both;
  }
  @keyframes reel-drift {
    from {
      transform: scale(1.16);
    }
    to {
      transform: scale(1.02);
    }
  }

  /* Voiles : lisibilité du menu (haut), du nom (droite) et de la légende (bas),
     quelle que soit la vidéo en dessous */
  .reel__scrim {
    z-index: 3;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(8, 8, 10, 0.62) 0%, rgba(8, 8, 10, 0) 24%),
      linear-gradient(0deg, rgba(8, 8, 10, 0.8) 0%, rgba(8, 8, 10, 0) 42%),
      linear-gradient(270deg, rgba(8, 8, 10, 0.78) 0%, rgba(8, 8, 10, 0.62) 44%, rgba(8, 8, 10, 0.2) 66%, rgba(8, 8, 10, 0) 78%),
      rgba(8, 8, 10, 0.16);
  }

  .reel__content {
    position: relative;
    z-index: 4;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    /* Le nom est en retrait du bord droit, vers le centre de l'écran */
    padding: 6rem clamp(1.25rem, 11vw, 12rem) 12rem clamp(1.25rem, 4vw, 4rem);
    text-shadow: 0 2px 28px rgba(0, 0, 0, 0.35);
  }

  .reel__bar {
    position: absolute;
    z-index: 4;
    left: 0;
    right: 0;
    bottom: 0;
    display: grid;
    gap: 1.25rem;
    padding: 0 clamp(1.25rem, 4vw, 4rem) clamp(1.25rem, 3vw, 2rem);
  }
  .reel__now {
    display: grid;
    justify-items: start;
    gap: 0.35rem;
    width: fit-content;
    max-width: 40rem;
    color: #fff;
    text-shadow: 0 1px 16px rgba(0, 0, 0, 0.45);
    transition:
      opacity 260ms ease,
      transform 260ms ease;
  }
  .reel__now.is-swap {
    opacity: 0;
    transform: translateY(8px);
  }
  .reel__count {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    font-variant-numeric: tabular-nums;
  }
  .reel__eyebrow {
    color: rgba(255, 255, 255, 0.85);
    text-transform: uppercase;
  }
  .reel__k {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.85;
  }
  .reel__t {
    font-stretch: 125%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(1.15rem, 0.85rem + 1.2vw, 1.9rem);
    line-height: 1.08;
  }
  .reel__credit {
    margin-top: 0.3rem;
    font-size: 0.7rem;
    letter-spacing: 0.03em;
    color: rgba(255, 255, 255, 0.72);
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.28);
  }
  .reel__credit:hover {
    color: #fff;
    border-color: var(--accent);
  }
  .reel__controls {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .reel__dots {
    flex: 1;
    display: flex;
    gap: 6px;
  }
  .reel__dot {
    flex: 1;
    height: 22px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    display: flex;
    align-items: center;
  }
  .reel__dot i {
    position: relative;
    display: block;
    width: 100%;
    height: 3px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.3);
    overflow: hidden;
  }
  .reel__dot i::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }
  .reel__dot.is-done i::after {
    transform: scaleX(1);
    background: rgba(255, 255, 255, 0.85);
  }
  .reel__dot.is-on i::after {
    animation: reel-fill var(--dur) linear forwards;
  }
  .reel__dot:hover i {
    background: rgba(255, 255, 255, 0.55);
  }
  @keyframes reel-fill {
    to {
      transform: scaleX(1);
    }
  }
  .reel__pause {
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.5);
    background: rgba(8, 8, 10, 0.25);
    color: #fff;
    display: grid;
    place-items: center;
    cursor: pointer;
  }
  .reel__pause:hover {
    border-color: #fff;
  }
  .reel__pause svg {
    width: 0.85rem;
    height: 0.85rem;
    fill: currentColor;
  }
  .reel .i-play,
  .reel.is-paused .i-pause {
    display: none;
  }
  .reel.is-paused .i-play {
    display: block;
  }
  .reel.is-paused .reel__dot.is-on i::after,
  .reel.is-hold .reel__dot.is-on i::after,
  .reel.is-wait .reel__dot.is-on i::after,
  .reel.is-paused .reel__slide video,
  .reel.is-hold .reel__slide video {
    animation-play-state: paused;
  }
  .reel :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  /* ── Version « noir » : filtre noir et blanc contrasté sur les vidéos ──── */
  .reel--noir .reel__slide video {
    filter: grayscale(1) contrast(1.55) brightness(1.06);
  }

  /* ── Version « trait » : vidéos filtrées en dessin, traits noirs sur blanc ─ */
  .reel--trait {
    --ink: #0d0d0f;
    background: #fff;
    color: var(--ink);
  }
  .reel--trait .reel__slide {
    background: #fff;
  }
  .reel--trait .reel__scrim {
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.85) 0%, rgba(255, 255, 255, 0) 20%),
      linear-gradient(0deg, rgba(255, 255, 255, 0.92) 0%, rgba(255, 255, 255, 0) 40%),
      linear-gradient(270deg, rgba(255, 255, 255, 0.88) 0%, rgba(255, 255, 255, 0.72) 44%, rgba(255, 255, 255, 0.2) 66%, rgba(255, 255, 255, 0) 78%);
  }
  .reel--trait .reel__content {
    text-shadow:
      0 0 18px #fff,
      0 0 6px #fff;
  }
  .reel--trait .reel__now {
    color: var(--ink);
    text-shadow:
      0 0 14px #fff,
      0 0 4px #fff;
  }
  .reel--trait .reel__eyebrow {
    color: rgba(13, 13, 15, 0.72);
  }
  .reel--trait .reel__credit {
    color: rgba(13, 13, 15, 0.7);
    border-bottom-color: rgba(13, 13, 15, 0.3);
  }
  .reel--trait .reel__credit:hover {
    color: var(--ink);
  }
  .reel--trait .reel__dot i {
    background: rgba(13, 13, 15, 0.16);
  }
  .reel--trait .reel__dot.is-done i::after {
    background: rgba(13, 13, 15, 0.8);
  }
  .reel--trait .reel__dot:hover i {
    background: rgba(13, 13, 15, 0.32);
  }
  .reel--trait .reel__pause {
    border-color: rgba(13, 13, 15, 0.45);
    background: rgba(255, 255, 255, 0.7);
    color: var(--ink);
  }
  .reel--trait .reel__pause:hover {
    border-color: var(--ink);
  }

  @media (max-width: 47.99rem) {
    .reel--trait .reel__scrim {
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.85) 0%, rgba(255, 255, 255, 0) 20%),
        linear-gradient(0deg, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.75) 45%, rgba(255, 255, 255, 0) 75%);
    }
    .reel__content {
      align-items: flex-end;
      justify-content: flex-start;
      padding-right: clamp(1.25rem, 4vw, 4rem);
      padding-bottom: 15rem;
    }
    .reel__scrim {
      background:
        linear-gradient(180deg, rgba(8, 8, 10, 0.6) 0%, rgba(8, 8, 10, 0) 22%),
        linear-gradient(0deg, rgba(8, 8, 10, 0.88) 0%, rgba(8, 8, 10, 0.58) 45%, rgba(8, 8, 10, 0) 75%),
        rgba(8, 8, 10, 0.14);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reel__slide video {
      animation: none !important;
      transform: none;
    }
    .reel__dot.is-on i::after {
      animation: none;
      transform: scaleX(1);
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-reel]');
  if (root) {
    const slides = [...root.querySelectorAll<HTMLElement>('.reel__slide')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('.reel__dot')];
    const bar = root.querySelector<HTMLElement>('.reel__bar')!;
    const now = root.querySelector<HTMLElement>('[data-reel-now]')!;
    const elN = root.querySelector('[data-reel-n]')!;
    const elK = root.querySelector('[data-reel-k]')!;
    const elT = root.querySelector('[data-reel-t]')!;
    const credit = root.querySelector<HTMLAnchorElement>('[data-reel-credit]')!;
    const creditText = root.querySelector('[data-reel-credit-text]')!;
    const pauseBtn = root.querySelector<HTMLButtonElement>('[data-reel-pause]')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // 720p sur petit écran, en mode économie de données ou sur connexion lente
    type Conn = { saveData?: boolean; effectiveType?: string; downlink?: number };
    const conn = (navigator as Navigator & { connection?: Conn }).connection;
    const slow = Boolean(conn && (conn.saveData || (conn.effectiveType && conn.effectiveType !== '4g') || (conn.downlink && conn.downlink < 5)));
    const small = slow || window.matchMedia('(max-width: 900px)').matches;
    const n = slides.length;
    let current = 0;
    let busy = false;
    let pending: number | null = null;
    let dir = 1;
    let swapTimer = 0;
    let waitTimer = 0;

    // Raisons de suspendre le défilement (en plus de la pause choisie) :
    // en-tête hors de l'écran, onglet caché, focus ou souris sur les commandes.
    const held = { off: root.getBoundingClientRect().bottom <= 0, hidden: document.hidden, focus: false, hover: false };

    const wrap = (i: number) => ((i % n) + n) % n;
    const video = (i: number) => slides[wrap(i)].querySelector('video')!;
    const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
    const isPaused = () => root.classList.contains('is-paused');
    const isHeld = () => held.off || held.hidden || held.focus || held.hover;
    const canPlay = () => !isPaused() && !isHeld();

    // Affiche seule (aucune vidéo téléchargée)
    const prime = (i: number) => {
      const v = video(i);
      if (!v.getAttribute('poster')) v.poster = v.dataset.poster ?? '';
    };
    // Charge une vidéo (une seule fois)
    const warm = (i: number) => {
      prime(i);
      const v = video(i);
      if (v.getAttribute('src')) return;
      v.src = (small ? v.dataset.sd : v.dataset.hd) ?? '';
      v.preload = 'auto';
      v.load();
    };
    // Précharge la suivante seulement si le défilement peut continuer
    const warmNext = () => {
      if (!reduce && canPlay()) warm(current + 1);
    };
    const playAt = (i: number) => {
      if (!canPlay()) return;
      warm(i);
      video(i)
        .play()
        .catch((e: DOMException) => {
          // Lecture automatique refusée (mode économie d'énergie…) : on passe
          // en pause, et le bouton propose alors de relancer
          if (e.name === 'NotAllowedError') setPaused(true);
        });
    };

    // La minuterie (remplissage du segment) attend que la vidéo joue vraiment,
    // trois secondes au plus, pour ne pas montrer une affiche fixe sur une connexion lente
    const waitFor = (i: number) => {
      window.clearTimeout(waitTimer);
      const v = video(i);
      if (reduce || v.readyState >= 3) {
        root.classList.remove('is-wait');
        return;
      }
      root.classList.add('is-wait');
      const done = () => {
        window.clearTimeout(waitTimer);
        v.removeEventListener('playing', done);
        root.classList.remove('is-wait');
      };
      v.addEventListener('playing', done);
      waitTimer = window.setTimeout(done, 3000);
    };

    // Révélation par bandes verticales décalées (clip-path recalculé à chaque image)
    const reveal = (el: HTMLElement, d: number, done: () => void) => {
      if (reduce) {
        done();
        return;
      }
      const strips = window.innerWidth < 640 ? 4 : 6;
      const dur = 760;
      const stagger = 75;
      const total = dur + stagger * (strips - 1);
      const t0 = performance.now();
      const frame = (t1: number) => {
        const t = t1 - t0;
        const top: string[] = [];
        const bottom: string[] = [];
        for (let i = 0; i < strips; i++) {
          const order = d > 0 ? i : strips - 1 - i;
          const p = ease(Math.min(1, Math.max(0, (t - order * stagger) / dur)));
          const x0 = ((i / strips) * 100).toFixed(3);
          const x1 = (((i + 1) / strips) * 100).toFixed(3);
          const yTop = d > 0 ? (1 - p) * 100 : 0;
          const yBot = d > 0 ? 100 : p * 100;
          top.push(`${x0}% ${yTop}%`, `${x1}% ${yTop}%`);
          bottom.unshift(`${x1}% ${yBot}%`, `${x0}% ${yBot}%`);
        }
        el.style.clipPath = `polygon(${top.concat(bottom).join(',')})`;
        if (t < total) requestAnimationFrame(frame);
        else {
          el.style.clipPath = '';
          done();
        }
      };
      el.style.clipPath = 'polygon(0 100%, 100% 100%, 100% 100%, 0 100%)';
      requestAnimationFrame(frame);
    };

    const updateCaption = (i: number) => {
      const s = slides[i].dataset;
      window.clearTimeout(swapTimer);
      now.classList.add('is-swap');
      swapTimer = window.setTimeout(() => {
        elN.textContent = String(i + 1).padStart(2, '0');
        elK.textContent = s.k ?? '';
        elT.textContent = s.t ?? '';
        creditText.textContent = s.credit ?? '';
        credit.href = s.source ?? '#';
        now.classList.remove('is-swap');
      }, 260);
    };

    const go = (target: number) => {
      const next = wrap(target);
      if (busy) {
        // Une demande pendant la transition est gardée et jouée juste après
        pending = next;
        return;
      }
      if (next === current) return;
      busy = true;
      const prev = current;
      current = next;
      const inEl = slides[current];
      root.style.setProperty('--accent', inEl.dataset.accent ?? '#fff');
      dots.forEach((b, i) => {
        b.classList.toggle('is-on', i === current);
        b.classList.toggle('is-done', i < current);
        if (i === current) b.setAttribute('aria-current', 'true');
        else b.removeAttribute('aria-current');
      });
      // Redémarre l'animation de remplissage du segment courant
      const fill = dots[current];
      fill.classList.remove('is-on');
      void fill.offsetWidth;
      fill.classList.add('is-on');
      updateCaption(current);
      prime(current);
      video(current).currentTime = 0;
      playAt(current);
      waitFor(current);
      inEl.classList.add('is-in');
      if (reduce) prime(current + 1);
      else warmNext();
      reveal(inEl, dir, () => {
        slides[prev].classList.remove('is-on');
        video(prev).pause();
        inEl.classList.remove('is-in');
        inEl.classList.add('is-on');
        busy = false;
        if (pending !== null) {
          const p = pending;
          pending = null;
          go(p);
        }
      });
      dir = -dir;
    };

    // Le segment courant de la barre sert de minuterie : à la fin de son
    // remplissage, on passe à la vidéo suivante.
    dots.forEach((b, i) => {
      b.addEventListener('click', () => go(i));
      b.querySelector('i')!.addEventListener('animationend', () => {
        if (i === current && !reduce) go(current + 1);
      });
    });

    function setPaused(p: boolean) {
      root!.classList.toggle('is-paused', p);
      pauseBtn.setAttribute('aria-label', p ? 'Relancer les vidéos' : 'Mettre les vidéos en pause');
      if (p) video(current).pause();
      else {
        playAt(current);
        warmNext();
      }
    }
    pauseBtn.addEventListener('click', () => setPaused(!isPaused()));

    // Applique les raisons de suspension : la vidéo et la minuterie s'arrêtent ensemble
    const applyHold = () => {
      root.classList.toggle('is-hold', isHeld());
      if (isHeld()) video(current).pause();
      else playAt(current);
    };
    new IntersectionObserver(
      ([e]) => {
        held.off = !e.isIntersecting;
        applyHold();
      },
      { threshold: 0.05 },
    ).observe(root);
    document.addEventListener('visibilitychange', () => {
      held.hidden = document.hidden;
      applyHold();
    });
    // Le défilement s'arrête tant que le clavier ou la souris est sur les commandes
    bar.addEventListener('focusin', () => {
      held.focus = true;
      applyHold();
    });
    bar.addEventListener('focusout', (e) => {
      if (bar.contains(e.relatedTarget as Node | null)) return;
      held.focus = false;
      applyHold();
    });
    bar.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse') return;
      held.hover = true;
      applyHold();
    });
    bar.addEventListener('pointerleave', (e) => {
      if (e.pointerType !== 'mouse') return;
      held.hover = false;
      applyHold();
    });

    // Mouvement réduit : affiche fixe, rien n'est téléchargé tant qu'on ne relance pas
    if (reduce) setPaused(true);
    else {
      root.classList.toggle('is-hold', isHeld());
      playAt(0);
      waitFor(0);
      // La vidéo suivante se charge une fois la première lancée
      video(0).addEventListener('playing', warmNext, { once: true });
    }
  }
</script>
