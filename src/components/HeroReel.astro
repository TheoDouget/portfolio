---
// Diaporama plein écran des projets, pour l'en-tête de la proposition C.
// Chaque image entre par bandes verticales décalées, puis dérive lentement
// (zoom arrière). La couleur d'accent suit l'image affichée.
// Le contenu du slot (le nom) est posé par-dessus, sur un voile sombre.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { url } from '../lib/url.js';
import { typo } from '../lib/typo.js';

interface Slide {
  img?: ImageMetadata;
  video?: { src: string; poster: string };
  k: string;
  t: string;
  href: string;
  go?: string;
  accent: string;
  pos?: string;
}
interface Props {
  slides: Slide[];
  duration?: number;
}
const { slides, duration = 4600 } = Astro.props;
const first = slides[0];
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="reel" id="top" aria-label="Présentation" data-reel style={`--dur:${duration}ms; --accent:${first.accent}`}>
  <div class="reel__slides" aria-hidden="true">
    {
      slides.map((s, i) => (
        <figure
          class:list={['reel__slide', { 'is-on': i === 0 }]}
          data-k={typo(s.k)}
          data-t={typo(s.t)}
          data-href={url(s.href)}
          data-go={s.go ?? 'Voir le projet'}
          data-accent={s.accent}
          style={s.pos ? `--pos:${s.pos}` : undefined}
        >
          {s.video ? (
            <video muted playsinline loop preload="none" poster={url(s.video.poster)} tabindex="-1">
              <source src={url(s.video.src)} type="video/mp4" />
            </video>
          ) : (
            <Picture
              src={s.img!}
              alt=""
              formats={['avif', 'webp']}
              fallbackFormat="jpg"
              widths={[800, 1400, 2000].filter((w) => w <= s.img!.width)}
              sizes="100vw"
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'auto'}
            />
          )}
        </figure>
      ))
    }
  </div>
  <div class="reel__scrim" aria-hidden="true"></div>

  <div class="reel__content">
    <slot />
  </div>

  <div class="reel__bar">
    <a class="reel__now" href={url(first.href)} data-reel-link>
      <span class="reel__count"><span data-reel-n>01</span> / {pad(slides.length)}</span>
      <span class="reel__k" data-reel-k>{typo(first.k)}</span>
      <span class="reel__t" data-reel-t>{typo(first.t)}</span>
      <span class="reel__go"><span data-reel-go>{first.go ?? 'Voir le projet'}</span> <span aria-hidden="true">→</span></span>
    </a>
    <div class="reel__controls">
      <div class="reel__dots" role="group" aria-label="Choisir un projet">
        {
          slides.map((s, i) => (
            <button type="button" class:list={['reel__dot', { 'is-on': i === 0 }]} aria-label={typo(`Projet ${i + 1} : ${s.t}`)} aria-current={i === 0 ? 'true' : undefined}>
              <i />
            </button>
          ))
        }
      </div>
      <button type="button" class="reel__pause" data-reel-pause aria-pressed="false" aria-label="Mettre le diaporama en pause">
        <svg viewBox="0 0 16 16" aria-hidden="true" class="i-pause"><rect x="3" y="2" width="3.5" height="12" rx="1"></rect><rect x="9.5" y="2" width="3.5" height="12" rx="1"></rect></svg>
        <svg viewBox="0 0 16 16" aria-hidden="true" class="i-play"><path d="M4 2.5v11l9.5-5.5z"></path></svg>
      </button>
    </div>
  </div>
</section>

<style>
  @property --accent {
    syntax: '<color>';
    inherits: true;
    initial-value: #ffffff;
  }
  .reel {
    position: relative;
    height: 100vh;
    height: 100svh;
    min-height: 34rem;
    overflow: hidden;
    background: #0d0d0f;
    color: #fff;
    isolation: isolate;
    transition: --accent 900ms ease;
  }
  .reel__slides,
  .reel__slide,
  .reel__scrim {
    position: absolute;
    inset: 0;
  }
  .reel__slide {
    margin: 0;
    overflow: hidden;
    visibility: hidden;
    z-index: 0;
  }
  .reel__slide.is-on {
    visibility: visible;
    z-index: 1;
  }
  .reel__slide.is-in {
    visibility: visible;
    z-index: 2;
  }
  .reel__slide :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .reel__slide :global(img),
  .reel__slide video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--pos, 50% 50%);
    transform: scale(1.06);
    will-change: transform;
  }
  .reel__slide.is-on :global(img),
  .reel__slide.is-on video,
  .reel__slide.is-in :global(img),
  .reel__slide.is-in video {
    animation: reel-drift calc(var(--dur) + 1400ms) cubic-bezier(0.16, 0.7, 0.2, 1) both;
  }
  @keyframes reel-drift {
    from {
      transform: scale(1.24);
    }
    to {
      transform: scale(1.03);
    }
  }

  /* Voiles : lisibilité du menu (haut), du nom (droite) et de la légende (bas),
     quelle que soit l'image en dessous */
  .reel__scrim {
    z-index: 3;
    pointer-events: none;
    background:
      linear-gradient(180deg, rgba(8, 8, 10, 0.62) 0%, rgba(8, 8, 10, 0) 24%),
      linear-gradient(0deg, rgba(8, 8, 10, 0.78) 0%, rgba(8, 8, 10, 0) 42%),
      linear-gradient(270deg, rgba(8, 8, 10, 0.8) 0%, rgba(8, 8, 10, 0.62) 38%, rgba(8, 8, 10, 0.2) 60%, rgba(8, 8, 10, 0) 72%),
      rgba(8, 8, 10, 0.14);
  }

  .reel__content {
    position: relative;
    z-index: 4;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: 6rem clamp(1.25rem, 4vw, 4rem) 12rem;
    text-shadow: 0 2px 28px rgba(0, 0, 0, 0.35);
  }

  .reel__bar {
    position: absolute;
    z-index: 4;
    left: 0;
    right: 0;
    bottom: 0;
    display: grid;
    gap: 1.25rem;
    padding: 0 clamp(1.25rem, 4vw, 4rem) clamp(1.25rem, 3vw, 2rem);
  }
  .reel__now {
    display: grid;
    justify-items: start;
    gap: 0.35rem;
    width: fit-content;
    max-width: 40rem;
    color: #fff;
    text-decoration: none;
    transition:
      opacity 260ms ease,
      transform 260ms ease;
  }
  .reel__now.is-swap {
    opacity: 0;
    transform: translateY(8px);
  }
  .reel__count {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    font-variant-numeric: tabular-nums;
    color: var(--accent);
  }
  .reel__k {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.85;
  }
  .reel__t {
    font-stretch: 125%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(1.15rem, 0.85rem + 1.2vw, 1.9rem);
    line-height: 1.08;
  }
  .reel__go {
    margin-top: 0.4rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    border-bottom: 2px solid var(--accent);
    padding-bottom: 0.15rem;
  }
  .reel__now:hover .reel__go [aria-hidden],
  .reel__now:focus-visible .reel__go [aria-hidden] {
    display: inline-block;
    transform: translateX(4px);
  }
  .reel__controls {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .reel__dots {
    flex: 1;
    display: flex;
    gap: 6px;
  }
  .reel__dot {
    flex: 1;
    height: 22px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    display: flex;
    align-items: center;
  }
  .reel__dot i {
    position: relative;
    display: block;
    width: 100%;
    height: 3px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.3);
    overflow: hidden;
  }
  .reel__dot i::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }
  .reel__dot.is-done i::after {
    transform: scaleX(1);
    background: rgba(255, 255, 255, 0.85);
  }
  .reel__dot.is-on i::after {
    animation: reel-fill var(--dur) linear forwards;
  }
  .reel__dot:hover i {
    background: rgba(255, 255, 255, 0.55);
  }
  @keyframes reel-fill {
    to {
      transform: scaleX(1);
    }
  }
  .reel__pause {
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.5);
    background: rgba(8, 8, 10, 0.25);
    color: #fff;
    display: grid;
    place-items: center;
    cursor: pointer;
  }
  .reel__pause:hover {
    border-color: #fff;
  }
  .reel__pause svg {
    width: 0.85rem;
    height: 0.85rem;
    fill: currentColor;
  }
  .reel .i-play,
  .reel.is-paused .i-pause {
    display: none;
  }
  .reel.is-paused .i-play {
    display: block;
  }
  .reel.is-paused .reel__dot.is-on i::after,
  .reel.is-hold .reel__dot.is-on i::after,
  .reel.is-paused .reel__slide :global(img),
  .reel.is-hold .reel__slide :global(img),
  .reel.is-paused .reel__slide video,
  .reel.is-hold .reel__slide video {
    animation-play-state: paused;
  }
  .reel :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  @media (max-width: 47.99rem) {
    .reel__content {
      align-items: flex-end;
      justify-content: flex-start;
      padding-bottom: 14.5rem;
    }
    .reel__scrim {
      background:
        linear-gradient(180deg, rgba(8, 8, 10, 0.6) 0%, rgba(8, 8, 10, 0) 22%),
        linear-gradient(0deg, rgba(8, 8, 10, 0.86) 0%, rgba(8, 8, 10, 0.55) 45%, rgba(8, 8, 10, 0) 75%),
        rgba(8, 8, 10, 0.12);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reel__slide :global(img),
    .reel__slide video {
      animation: none !important;
      transform: none;
    }
    .reel__dot.is-on i::after {
      animation: none;
      transform: scaleX(1);
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-reel]');
  if (root) {
    const slides = [...root.querySelectorAll<HTMLElement>('.reel__slide')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('.reel__dot')];
    const link = root.querySelector<HTMLAnchorElement>('[data-reel-link]')!;
    const elN = root.querySelector('[data-reel-n]')!;
    const elK = root.querySelector('[data-reel-k]')!;
    const elT = root.querySelector('[data-reel-t]')!;
    const elGo = root.querySelector('[data-reel-go]')!;
    const pauseBtn = root.querySelector<HTMLButtonElement>('[data-reel-pause]')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    let busy = false;
    let dir = 1;
    let swapTimer = 0;

    const video = (i: number) => slides[i]?.querySelector('video');
    const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

    // Charge la vidéo de la diapositive suivante un peu à l'avance
    const warm = (i: number) => {
      const v = video(i);
      if (v && v.preload !== 'auto') {
        v.preload = 'auto';
        v.load();
      }
    };

    // Révélation par bandes verticales décalées (clip-path recalculé à chaque image)
    const reveal = (el: HTMLElement, d: number, done: () => void) => {
      if (reduce) {
        done();
        return;
      }
      const n = window.innerWidth < 640 ? 4 : 6;
      const dur = 760;
      const stagger = 75;
      const total = dur + stagger * (n - 1);
      const t0 = performance.now();
      const frame = (now: number) => {
        const t = now - t0;
        const top: string[] = [];
        const bottom: string[] = [];
        for (let i = 0; i < n; i++) {
          const order = d > 0 ? i : n - 1 - i;
          const p = ease(Math.min(1, Math.max(0, (t - order * stagger) / dur)));
          const x0 = ((i / n) * 100).toFixed(3);
          const x1 = (((i + 1) / n) * 100).toFixed(3);
          const yTop = d > 0 ? (1 - p) * 100 : 0;
          const yBot = d > 0 ? 100 : p * 100;
          top.push(`${x0}% ${yTop}%`, `${x1}% ${yTop}%`);
          bottom.unshift(`${x1}% ${yBot}%`, `${x0}% ${yBot}%`);
        }
        el.style.clipPath = `polygon(${top.concat(bottom).join(',')})`;
        if (t < total) requestAnimationFrame(frame);
        else {
          el.style.clipPath = '';
          done();
        }
      };
      el.style.clipPath = 'polygon(0 100%, 100% 100%, 100% 100%, 0 100%)';
      requestAnimationFrame(frame);
    };

    const updateCaption = (i: number) => {
      const s = slides[i].dataset;
      window.clearTimeout(swapTimer);
      link.classList.add('is-swap');
      swapTimer = window.setTimeout(() => {
        elN.textContent = String(i + 1).padStart(2, '0');
        elK.textContent = s.k ?? '';
        elT.textContent = s.t ?? '';
        elGo.textContent = s.go ?? '';
        link.href = s.href ?? '#';
        link.classList.remove('is-swap');
      }, 260);
    };

    const go = (next: number) => {
      if (busy || next === current) return;
      busy = true;
      const prev = current;
      current = (next + slides.length) % slides.length;
      const inEl = slides[current];
      root.style.setProperty('--accent', inEl.dataset.accent ?? '#fff');
      dots.forEach((b, i) => {
        b.classList.toggle('is-on', i === current);
        b.classList.toggle('is-done', i < current);
        if (i === current) b.setAttribute('aria-current', 'true');
        else b.removeAttribute('aria-current');
      });
      // Redémarre l'animation de remplissage du segment courant
      const fill = dots[current];
      fill.classList.remove('is-on');
      void fill.offsetWidth;
      fill.classList.add('is-on');
      updateCaption(current);
      inEl.classList.add('is-in');
      const v = video(current);
      if (v && !root.classList.contains('is-paused')) {
        v.currentTime = 0;
        v.play().catch(() => {});
      }
      warm(current + 1);
      reveal(inEl, dir, () => {
        slides[prev].classList.remove('is-on');
        video(prev)?.pause();
        inEl.classList.remove('is-in');
        inEl.classList.add('is-on');
        busy = false;
      });
      dir = -dir;
    };

    // Le segment courant de la barre sert de minuterie : à la fin de son
    // remplissage, on passe à la diapositive suivante.
    dots.forEach((b, i) => {
      b.addEventListener('click', () => go(i));
      b.querySelector('i')!.addEventListener('animationend', () => {
        if (i === current && !reduce) go(current + 1);
      });
    });

    const setPaused = (p: boolean) => {
      root.classList.toggle('is-paused', p);
      pauseBtn.setAttribute('aria-pressed', String(p));
      pauseBtn.setAttribute('aria-label', p ? 'Relancer le diaporama' : 'Mettre le diaporama en pause');
      const v = video(current);
      if (v) (p ? v.pause() : v.play().catch(() => {}));
    };
    pauseBtn.addEventListener('click', () => setPaused(!root.classList.contains('is-paused')));
    if (reduce) setPaused(true);

    // Suspend quand l'en-tête n'est plus visible ou que l'onglet est caché
    const hold = (h: boolean) => {
      root.classList.toggle('is-hold', h);
      const v = video(current);
      if (v && !root.classList.contains('is-paused')) (h ? v.pause() : v.play().catch(() => {}));
    };
    new IntersectionObserver(([e]) => hold(!e.isIntersecting), { threshold: 0.05 }).observe(root);
    document.addEventListener('visibilitychange', () => hold(document.hidden));
    warm(1);
  }
</script>
