---
// Pied de page sombre : l'adresse e-mail en grand, les liens utiles, la
// disponibilité. Le slot accueille les crédits propres à une page.
import { site } from '../data/site.js';
import { url, dateLong } from '../lib/url.js';
---

<footer class="m-contact" id="contact">
  <p>Contact</p>
  <a class="mail wide" href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
  <p class="m-contact__avail">{site.availability.title}. {site.availability.detail}</p>
  <nav aria-label="Liens de contact">
    <a href={site.contact.linkedin} target="_blank" rel="noopener me">LinkedIn<span class="sr-only"> (nouvel onglet)</span></a>
    <a href={site.contact.cv} target="_blank" rel="noopener">CV<span class="sr-only"> (nouvel onglet)</span></a>
    <a href={url('')}>Accueil</a>
    <a href={url('projets/')}>Tous les projets</a>
    <a href={url('a-propos/')}>À propos</a>
  </nav>
  <small>© {site.updated.slice(0, 4)} {site.name} · mis à jour le {dateLong(site.updated)} · site statique, sans traceur ni cookie</small>
  <slot />
</footer>
