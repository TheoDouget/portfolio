---
import { site } from '../data/site.js';
import { dateLong } from '../lib/url.js';
const year = new Date().getFullYear();
---

<footer class="site-footer" id="contact">
  <div class="wrap">
    <div class="contact">
      <h2 class="display">Me contacter</h2>
      <div>
        <div class="contact__email">
          <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
          <button class="btn btn--small btn--outline" type="button" data-copy={site.contact.email} aria-live="polite">Copier</button>
        </div>
        <p>{site.availability.title}. {site.availability.detail}</p>
        <div class="contact__links">
          <a class="btn" href={site.contact.linkedin} rel="noopener me" target="_blank">LinkedIn<span class="sr-only"> (nouvel onglet)</span></a>
          <a class="btn" href={site.contact.cv} rel="noopener" target="_blank">Mon CV<span class="sr-only"> (nouvel onglet)</span></a>
        </div>
      </div>
    </div>
    <div class="colophon">
      <p>© {year} {site.name}</p>
      <p>Mis à jour le {dateLong(site.updated)} · site statique, sans traceur ni cookie</p>
    </div>
  </div>
</footer>
