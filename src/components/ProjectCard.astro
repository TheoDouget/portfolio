---
// Carte de projet du carrousel d'accueil (inspirée de davisryan.tech).
import type { CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import { url } from '../lib/url.js';

interface Props {
  project: CollectionEntry<'projets'>;
  eager?: boolean;
}
const { project, eager = false } = Astro.props;
const d = project.data;
---

<li class="slide">
  <div class:list={['slide__img', { 'slide__img--contain': d.coverFit === 'contain' }]}>
    <Picture
      src={d.cover}
      alt=""
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      widths={[400, 800].filter((w) => w <= d.cover.width)}
      sizes="24rem"
      loading={eager ? 'eager' : 'lazy'}
    />
  </div>
  <p class="kicker">{d.year} · {d.domains.slice(0, 2).join(' · ')}</p>
  <h3 class="slide__title"><a href={url(`projets/${project.id}/`)}>{d.title}</a></h3>
  <p class="slide__summary">{d.summary}</p>
  <span class="btn btn--small" aria-hidden="true">En savoir plus</span>
</li>
