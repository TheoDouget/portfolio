---
// Figure d'étude de cas : image optimisée (AVIF/WebP, srcset), légende
// numérotée automatiquement par CSS, agrandissement au clic (dialog natif).
import type { ImageMetadata } from 'astro';
import { Picture, getImage } from 'astro:assets';
import { typo } from '../lib/typo.js';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** Élargit la figure au-delà de la colonne de texte. */
  wide?: boolean;
  /** Encadre l'image sur fond --surface (captures, CAO, schémas). */
  frame?: boolean;
  /** Hauteur max de l'image affichée (utile pour les photos verticales). */
  maxHeight?: string;
}

const { src, wide = false, frame = false, maxHeight } = Astro.props;
const alt = typo(Astro.props.alt);
const caption = Astro.props.caption ? typo(Astro.props.caption) : undefined;
const zoom = await getImage({ src, width: Math.min(src.width, 2000), format: 'webp' });
const sizes = wide ? '(min-width: 70rem) 60rem, 100vw' : '(min-width: 50rem) 42rem, 100vw';
---

<figure class:list={['fig', { 'fig--wide': wide, 'fig--frame': frame }]}>
  <a class="fig__link" href={zoom.src} data-zoom data-zoom-alt={alt} aria-label={`Agrandir : ${alt}`}>
    <Picture
      src={src}
      alt={alt}
      formats={['avif', 'webp']}
      widths={[480, 800, 1200, 1600].filter((w) => w <= src.width).concat(src.width < 480 ? [src.width] : [])}
      sizes={sizes}
      style={maxHeight ? `max-height:${maxHeight};width:auto;margin-inline:auto` : undefined}
    />
  </a>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
