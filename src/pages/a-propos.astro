---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Recognition from '../components/Recognition.astro';
import { site } from '../data/site.js';
import { url } from '../lib/url.js';
import { getProjects } from '../lib/projects';
import bandeau from '../assets/photos/pitch-bandeau.jpg';
import scene from '../assets/photos/scene-laureat.jpg';
import planLarge from '../assets/photos/pitch-plan-large.jpg';
import laureat from '../assets/photos/laureat-cheque.jpg';

const projects = await getProjects();
const titleOf = Object.fromEntries(projects.map((p) => [p.id, p.data.title]));
---

<Base
  title="À propos"
  description="Parcours, compétences et distinctions de Théo Douget, élève-ingénieur à SIGMA Clermont et co-fondateur d'Anonym-IA."
>
  <h1 class="page-title">À propos</h1>
  <p class="page-intro">{site.role}. {site.availability.title}.</p>

  <figure class="photo-band photo-band--bw">
    <Picture
      src={bandeau}
      alt="Théo Douget au micro pendant son pitch, devant l’écran de la cérémonie des lauréats régionaux du Prix Pépite 2026."
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      widths={[800, 1400, 2000, 2400]}
      sizes="100vw"
      loading="eager"
    />
  </figure>

  <section class="resume" aria-label="Présentation">
    <div class="resume__text">
      {site.bio.map((p) => <p>{p}</p>)}
      <div class="btn-row">
        <a class="btn" href="#contact">Me contacter</a>
        <a class="btn" href={site.contact.cv} rel="noopener" target="_blank">Mon CV<span class="sr-only"> (nouvel onglet)</span></a>
        <a class="btn" href={site.contact.linkedin} rel="noopener" target="_blank">LinkedIn<span class="sr-only"> (nouvel onglet)</span></a>
      </div>
    </div>
    <div class="resume__photos">
      <figure>
        <Picture src={scene} alt="Théo Douget sur scène, sous l’écran « Lauréat · Anonym-IA · Théo Douget »." formats={['avif', 'webp']} fallbackFormat="jpg" widths={[600, 1000, 1400]} sizes="(min-width: 56rem) 40vw, 100vw" />
        <figcaption>Cérémonie des lauréats régionaux du Prix Pépite 2026, Lyon.</figcaption>
      </figure>
      <figure>
        <Picture src={planLarge} alt="Théo Douget au micro, entre les bannières de la Région et de Bpifrance." formats={['avif', 'webp']} fallbackFormat="jpg" widths={[400, 800]} sizes="(min-width: 56rem) 20vw, 50vw" />
      </figure>
      <figure>
        <Picture src={laureat} alt="Théo Douget tenant son chèque de lauréat du Prix Pépite 2026." formats={['avif', 'webp']} fallbackFormat="jpg" widths={[400, 800]} sizes="(min-width: 56rem) 20vw, 50vw" />
      </figure>
    </div>
  </section>

  <div class="section">
    <section class="band" aria-labelledby="parcours">
      <div class="band__grid">
        <h2 class="display" id="parcours">Parcours</h2>
        <div>
          <p>Le détail complet de mon parcours vit sur LinkedIn. Ici, l’essentiel, et un lien vers l’étude de cas quand il y en a une.</p>
          <hr />
          <h3>Expériences</h3>
          <ul class="cols">
            {
              site.experiences.map((e) => (
                <li class="entry">
                  <strong>{e.title}</strong>
                  <span>{e.org}</span>
                  <span class="dates">{e.dates}</span>
                  {e.href && <a href={url(e.href)}>Étude de cas →</a>}
                </li>
              ))
            }
          </ul>
          <hr />
          <h3>Formation</h3>
          <ul class="cols">
            {
              site.education.map((e) => (
                <li class="entry">
                  <strong>{e.title}</strong>
                  <span>{e.org}</span>
                  <span class="dates">{e.dates}</span>
                </li>
              ))
            }
          </ul>
          <hr />
          <h3>Compétences</h3>
          <div class="skills-list">
            {
              site.skills.map((s) => (
                <div>
                  <h4>{s.group}</h4>
                  <p>{s.items}</p>
                  <p class="seen">
                    Voir :{' '}
                    {s.projects
                      .filter((id) => titleOf[id])
                      .map((id, i, arr) => (
                        <>
                          <a href={url(`projets/${id}/`)}>{titleOf[id]}</a>
                          {i < arr.length - 1 ? ' · ' : ''}
                        </>
                      ))}
                  </p>
                </div>
              ))
            }
          </div>
          <hr />
          <h3>Langues</h3>
          <ul class="cols">
            {
              site.languages.map((l) => (
                <li class="entry">
                  <strong>{l.name}</strong>
                  <span class="dates">{l.level}</span>
                </li>
              ))
            }
          </ul>
          <p class="muted" style="margin-top:2rem;max-width:var(--measure)">{site.outside}</p>
          <a class="btn btn--outline" href={site.contact.linkedin} rel="noopener" target="_blank" style="margin-top:1rem">
            Voir mon LinkedIn<span class="sr-only"> (nouvel onglet)</span>
          </a>
        </div>
      </div>
    </section>
  </div>

  <section class="section" aria-labelledby="distinctions">
    <div class="section-head">
      <h2 class="display" id="distinctions">Distinctions et presse</h2>
    </div>
    <Recognition />
  </section>
</Base>
