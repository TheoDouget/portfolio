---
import { Picture } from 'astro:assets';
import Site from '../layouts/Site.astro';
import PressList from '../components/PressList.astro';
import { site } from '../data/site.js';
import { url } from '../lib/url.js';
import { getProjects } from '../lib/projects';
import bandeau from '../assets/photos/pitch-bandeau.jpg';
import scene from '../assets/photos/scene-laureat.jpg';
import planLarge from '../assets/photos/pitch-plan-large.jpg';
import laureat from '../assets/photos/laureat-cheque.jpg';

const projects = await getProjects();
const titleOf = Object.fromEntries(projects.map((p) => [p.id, p.data.title]));
---

<Site
  title="À propos"
  description="Parcours, compétences et distinctions de Théo Douget, élève-ingénieur à SIGMA Clermont et co-fondateur d'Anonym-IA."
>
  <header class="m-page-head">
    <div class="m-wrap">
      <p class="m-eyebrow">{site.role}</p>
      <h1 class="wide">À propos</h1>
      <p class="m-page-intro">{site.availability.title}. {site.availability.detail}</p>
    </div>
  </header>

  <figure class="m-band">
    <Picture
      src={bandeau}
      alt="Théo Douget au micro pendant son pitch, devant l’écran de la cérémonie des lauréats régionaux du Prix Pépite 2026."
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      widths={[800, 1400, 2000, 2400]}
      sizes="100vw"
      loading="eager"
    />
  </figure>

  <section class="m-resume" aria-label="Présentation">
    <div class="m-resume__text">
      {site.bio.map((p) => <p>{p}</p>)}
      <p class="m-case-links">
        <a class="m-btn" href="#contact">Me contacter</a>
        <a class="m-btn" href={site.contact.cv} rel="noopener" target="_blank">Mon CV<span class="sr-only"> (nouvel onglet)</span></a>
        <a class="m-btn" href={site.contact.linkedin} rel="noopener" target="_blank">LinkedIn<span class="sr-only"> (nouvel onglet)</span></a>
      </p>
    </div>
    <div class="m-resume__photos">
      <figure>
        <Picture src={scene} alt="Théo Douget sur scène, sous l’écran « Lauréat · Anonym-IA · Théo Douget »." formats={['avif', 'webp']} fallbackFormat="jpg" widths={[600, 1000, 1400]} sizes="(min-width: 56rem) 40vw, 100vw" />
        <figcaption>Cérémonie des lauréats régionaux du Prix Pépite 2026, Lyon.</figcaption>
      </figure>
      <figure>
        <Picture src={planLarge} alt="Théo Douget au micro, entre les bannières de la Région et de Bpifrance." formats={['avif', 'webp']} fallbackFormat="jpg" widths={[400, 800]} sizes="(min-width: 56rem) 20vw, 50vw" />
      </figure>
      <figure>
        <Picture src={laureat} alt="Théo Douget tenant son chèque de lauréat régional du Prix Pépite 2026." formats={['avif', 'webp']} fallbackFormat="jpg" widths={[400, 800]} sizes="(min-width: 56rem) 20vw, 50vw" />
      </figure>
    </div>
  </section>

  <section class="m-cv" aria-labelledby="parcours-titre">
    <div class="m-wrap">
      <div class="m-sec-head">
        <h2 class="wide" id="parcours-titre">Parcours</h2>
        <p>Le détail complet vit sur LinkedIn. Ici, l’essentiel, avec un lien vers l’étude de cas quand il y en a une.</p>
      </div>

      <div class="m-cv__block">
        <h3>Expériences</h3>
        <ul class="m-rows">
          {
            site.experiences.map((e) => (
              <li>
                <span class="m-rows__date">{e.dates}</span>
                <span>
                  <strong>{e.title}</strong>
                  <span class="m-rows__org">{e.org}</span>
                </span>
                {e.href ? <a href={url(e.href)}>Étude de cas →</a> : <span />}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="m-cv__block">
        <h3>Formation</h3>
        <ul class="m-rows">
          {
            site.education.map((e) => (
              <li>
                <span class="m-rows__date">{e.dates}</span>
                <span>
                  <strong>{e.title}</strong>
                  <span class="m-rows__org">{e.org}</span>
                </span>
                <span />
              </li>
            ))
          }
        </ul>
      </div>

      <div class="m-cv__block">
        <h3>Compétences</h3>
        <div class="m-skills">
          {
            site.skills.map((s) => (
              <div>
                <h4>{s.group}</h4>
                <p>{s.items}</p>
                <p class="seen">
                  Voir&nbsp;:{' '}
                  {s.projects
                    .filter((id) => titleOf[id])
                    .map((id, i, arr) => (
                      <>
                        <a href={url(`projets/${id}/`)}>{titleOf[id]}</a>
                        {i < arr.length - 1 ? ' · ' : ''}
                      </>
                    ))}
                </p>
              </div>
            ))
          }
        </div>
      </div>

      <div class="m-cv__block">
        <h3>Langues</h3>
        <ul class="m-rows m-rows--two">
          {
            site.languages.map((l) => (
              <li>
                <strong>{l.name}</strong>
                <span class="m-rows__org">{l.level}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="m-cv__block">
        <h3>Centres d’intérêt</h3>
        <p class="m-cv__outside">
          {site.outside} <a href={`${url('')}#passions`}>Voir mes passions →</a>
        </p>
      </div>
    </div>
  </section>

  <section class="m-press" aria-labelledby="distinctions-titre">
    <div class="m-wrap">
      <div class="m-sec-head">
        <h2 class="wide" id="distinctions-titre">Distinctions et presse</h2>
      </div>
      <PressList />
    </div>
  </section>
</Site>
