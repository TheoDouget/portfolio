---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectRow from '../components/ProjectRow.astro';
import Recognition from '../components/Recognition.astro';
import { site } from '../data/site.js';
import { url, dateShort } from '../lib/url.js';
import { getProjects } from '../lib/projects';

const projects = await getProjects();
const featured = projects.filter((p) => p.data.tier === 'phare');
const others = projects.filter((p) => p.data.tier === 'projet');
---

<Base>
  <section class="hero" aria-labelledby="nom">
    <div>
      <p class="meta hero__role">{site.role}</p>
      <h1 id="nom">{site.name}</h1>
      <p class="hero__lead">{site.lead}</p>
      <div class="hero__avail">
        <strong>{site.availability.title}</strong>
        <p>{site.availability.detail}</p>
      </div>
      <p class="actions">
        <a href="#contact">Me contacter</a>
        <a href={url('projets/')}>Voir les projets</a>
        <a href={site.contact.linkedin} rel="noopener" target="_blank">LinkedIn<span class="sr-only"> (nouvel onglet)</span></a>
      </p>
    </div>
    <div class="now">
      <p class="meta now__title">Maintenant · {dateShort(site.updated)}</p>
      <ul>
        {
          site.now.map((n) => (
            <li>
              <span class="meta">{n.label}</span>
              <span>
                <a href={url(n.href)}>{n.text}</a>
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="projets-phares">
    <div class="section-head">
      <h2 id="projets-phares"><span class="num">01</span>Projets choisis</h2>
      <a href={url('projets/')}>Tous les projets →</a>
    </div>
    <ul class="features">
      {featured.map((p, i) => <ProjectCard project={p} eager={i < 2} />)}
    </ul>
  </section>

  <section class="section" aria-labelledby="autres-projets">
    <div class="section-head">
      <h2 id="autres-projets"><span class="num">02</span>Autres projets</h2>
    </div>
    <ul class="rows">
      {others.map((p) => <ProjectRow project={p} />)}
    </ul>
  </section>

  <section class="section" aria-labelledby="distinctions">
    <div class="section-head">
      <h2 id="distinctions"><span class="num">03</span>Distinctions et presse</h2>
      <a href={url('a-propos/')}>Parcours →</a>
    </div>
    <Recognition />
  </section>
</Base>
