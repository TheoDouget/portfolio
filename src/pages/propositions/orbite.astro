---
// Proposition B « Orbite » (inspirée de katieheinemann.space).
import '@fontsource-variable/space-grotesk/wght.css';
import '../../styles/prop-orbite.css';
import { Picture } from 'astro:assets';
import PropLayout from '../../layouts/PropLayout.astro';
import Globe from '../../components/Globe.astro';
import { site } from '../../data/site.js';
import { url } from '../../lib/url.js';
import { getProjects } from '../../lib/projects';
import bandeau from '../../assets/photos/pitch-bandeau.jpg';
import laureat from '../../assets/photos/laureat-cheque.jpg';
import maquette from '../../content/projets/batterie-gravitaire/maquette-trois-quarts.jpg';

const projects = (await getProjects()).slice(0, 6);

const doing = [
  { t: 'Robotique et vision', p: 'Suivi visuel et atterrissage autonome d’un drone : ArUco, filtre de Kalman, commande anticipative, banc d’essais en simulation.', href: 'projets/drone-atterrissage/', l: 'Le drone' },
  { t: 'Conception mécanique', p: 'Du cahier des charges à la pièce : robot tout-terrain pour le CNES, réducteur de 180 kW, tour de levage dimensionnée.', href: 'projets/perseus/', l: 'Le robot PERSEUS' },
  { t: 'Simulation', p: 'Éléments finis et optimisation topologique sous Ansys, simulation PX4 et Gazebo, calculs vérifiés à la main.', href: 'projets/optimisation-topologique/', l: 'L’optimisation' },
  { t: 'Logiciel et IA', p: 'CTO d’Anonym-IA : OCR, détection NER, pseudonymisation réversible, plus de 300 utilisateurs.', href: 'projets/anonym-ia/', l: 'Anonym-IA' },
  { t: 'Entrepreneuriat', p: 'Deux start-up portées en parallèle de l’école, un prix régional, une expédition au Québec.', href: 'projets/capy-invest/', l: 'CAPY Invest' },
  { t: 'Formation', p: 'SIGMA Clermont, domaine Machines, Robots et Systèmes, après La Prépa des INP à Nancy.', href: 'a-propos/', l: 'Mon parcours' },
];

const places = [
  { name: 'Clermont-Ferrand', lon: 3.09, lat: 45.78, when: '2024 → 2027', what: 'SIGMA Clermont · Anonym-IA' },
  { name: 'Nancy', lon: 6.18, lat: 48.69, when: '2022 → 2024', what: 'La Prépa des INP' },
  { name: 'Witry-lès-Reims', lon: 4.12, lat: 49.29, when: '2024', what: 'Stage chez CARBODY' },
  { name: 'La Tour-du-Pin', lon: 5.44, lat: 45.57, when: '2025', what: 'Stage chez Porcher Industries' },
  { name: 'Québec', lon: -71.21, lat: 46.81, when: 'mai 2026', what: 'Learning Expedition : pitch d’Anonym-IA' },
  { name: 'Hanoï', lon: 105.85, lat: 21.03, when: '2026', what: 'Stage R&D à l’USTH : drone autonome' },
  { name: 'Lyon', lon: 4.84, lat: 45.76, when: 'nov. 2026', what: 'Lauréat régional du Prix Pépite' },
];
---

<PropLayout title="Proposition B · Orbite">
  <header class="o-header">
    <a class="o-brand" href="#top">{site.name}</a>
    <nav class="o-nav" aria-label="Navigation">
      <a href="#projets">Projets</a>
      <a href="#parcours">Parcours</a>
      <a href="#contact">Contact</a>
      <a href={site.contact.cv} target="_blank" rel="noopener">CV ↗</a>
    </nav>
  </header>

  <section class="o-hero" id="top">
    <Picture src={bandeau} alt="" formats={['avif', 'webp']} fallbackFormat="jpg" widths={[800, 1400, 2000, 2400]} sizes="100vw" loading="eager" />
    <div class="o-hero__text">
      <h1>Théo<br />Douget</h1>
      <p>Élève-ingénieur en robotique et mécanique. Je fais travailler ensemble la mécanique, l’électronique, le code et l’IA, des drones aux logiciels en production.</p>
      <span class="o-tag">{site.availabilityShort}</span>
    </div>
  </section>

  <section class="o-section">
    <div class="wrap o-mission">
      <div class="o-mission__text">
        <h2 class="o-h2">Un ingénieur<br />qui construit.</h2>
        <p>{site.intro}</p>
        <p>{site.bio[2]}</p>
        <p>{site.bio[3]}</p>
        <a class="o-btn" href="#contact">Me contacter</a>
      </div>
      <div class="o-photos">
        <figure>
          <Picture src={laureat} alt="Théo Douget tenant son chèque de lauréat du Prix Pépite 2026." formats={['avif', 'webp']} fallbackFormat="jpg" widths={[480, 900]} sizes="26rem" />
          <figcaption>Lauréat régional du Prix Pépite 2026, Lyon.</figcaption>
        </figure>
        <figure>
          <Picture src={maquette} alt="Maquette au 1/10 de la tour de levage de la batterie gravitaire, en bois et pièces imprimées en 3D." formats={['avif', 'webp']} fallbackFormat="jpg" widths={[480, 900]} sizes="26rem" />
          <figcaption>Maquette au 1/10 de la batterie gravitaire, prépa, 2024.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="o-section">
    <div class="wrap">
      <h2 class="o-h2">Ce que je fais</h2>
      <div class="o-grid">
        {
          doing.map((d, i) => (
            <div>
              <span class="o-num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{d.t}</h3>
              <p>{d.p}</p>
              <a href={url(d.href)}>{d.l} →</a>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="o-section" id="projets">
    <div class="wrap">
      <div class="o-head-row">
        <h2 class="o-h2">Projets choisis</h2>
        <a class="o-btn" href={url('projets/')}>Tous les projets</a>
      </div>
      <ul class="o-projects">
        {
          projects.map((p, i) => (
            <li class="o-project">
              <div class:list={['o-project__img', { 'o-project__img--contain': p.data.coverFit === 'contain' }]}>
                <Picture src={p.data.cover} alt="" formats={['avif', 'webp']} fallbackFormat="jpg" widths={[480, 800].filter((w) => w <= p.data.cover.width)} sizes="(min-width: 64rem) 33vw, 100vw" />
              </div>
              <span class="o-num">{String(i + 1).padStart(2, '0')} · {p.data.year}</span>
              <h3><a href={url(`projets/${p.id}/`)}>{p.data.title}</a></h3>
              <p>{p.data.summary}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="o-space" id="parcours">
    <div class="wrap">
      <p class="o-kicker">Robotique · Mécanique · Entrepreneuriat</p>
      <h2 class="o-h2">Parcours</h2>
      <p class="o-lead">De Nancy à Hanoï, en passant par Québec. Faites tourner le globe ou choisissez un lieu.</p>
      <Globe places={places} />
    </div>
  </section>

  <section class="o-section">
    <div class="wrap">
      <h2 class="o-h2">Distinctions et presse</h2>
      <ul class="o-list">
        {
          site.recognition.map((r) => (
            <li>
              <span class="o-date">{r.date}</span>
              {r.url ? <a href={r.url} target="_blank" rel="noopener">{r.title}</a> : r.title}
              <span class="o-src"> — {r.source}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <footer class="o-footer" id="contact">
    <div class="wrap">
      <a class="o-email" href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
      <nav aria-label="Liens">
        <a href={url('projets/')}>Projets</a>
        <a href="#parcours">Parcours</a>
        <a href={site.contact.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        <a href={site.contact.cv} target="_blank" rel="noopener">CV</a>
      </nav>
      <small>© 2026 {site.name} · {site.availabilityShort}</small>
    </div>
  </footer>

  <a class="prop-pill" href={url('propositions/')}><span>B · Orbite</span> Voir les autres propositions</a>
</PropLayout>
