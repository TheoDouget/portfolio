---
import { render } from 'astro:content';
import { Picture, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { url, isExternal } from '../../lib/url.js';
import { getProjects, type Project } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: projects[i - 1] ?? null,
      next: projects[i + 1] ?? null,
    },
  }));
}

interface Props {
  entry: Project;
  prev: Project | null;
  next: Project | null;
}

const { entry, prev, next } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const og = await getImage({ src: d.cover, width: 1200, format: 'jpg' });
const photo = d.coverFit === 'cover';

// Ligne de faits sous le titre, comme « Liquid Engine Testing | 110+ Test Stand Hours »
const facts = [d.kicker.split(' · ').slice(1).join(' · ') || d.context, d.period, d.team];

const meta = [
  { label: 'Rôle', value: d.role },
  { label: 'Cadre', value: d.context },
  { label: 'Statut', value: d.status },
  { label: 'Outils', value: d.tools.join(', ') },
];
---

<Base title={d.title} description={d.summary} image={og.src} type="article">
  <article>
    <header class:list={['case-hero', { 'case-hero--plain': !photo }]}>
      <a class="case-hero__back" href={url('projets/')}>← Tous les projets</a>
      {
        photo ? (
          <Picture
            class="case-hero__media"
            src={d.cover}
            alt={d.coverAlt}
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            widths={[800, 1200, 1600, 2000].filter((w) => w <= d.cover.width)}
            sizes="100vw"
            loading="eager"
            fetchpriority="high"
          />
        ) : null
      }
      <div class="case-hero__text">
        <h1>{d.title}</h1>
        <p class="facts">{facts.map((f) => <span>{f}</span>)}</p>
      </div>
      {
        !photo && (
          <figure class="case-hero__figure">
            <Picture
              src={d.cover}
              alt={d.coverAlt}
              formats={['avif', 'webp']}
              fallbackFormat="png"
              widths={[600, 1000, 1400].filter((w) => w <= d.cover.width)}
              sizes="(min-width: 56rem) 50vw, 100vw"
              loading="eager"
              fetchpriority="high"
            />
          </figure>
        )
      }
    </header>

    <div class="case-intro">
      <p class="case-summary">{d.summary}</p>
      {
        d.keyFigures.length > 0 && (
          <dl class="figures">
            {d.keyFigures.map((f) => (
              <div>
                <dt>{f.value}</dt>
                <dd>{f.label}</dd>
              </div>
            ))}
          </dl>
        )
      }
      <dl class="case-meta">
        {
          meta.map((m) => (
            <div>
              <dt>{m.label}</dt>
              <dd>{m.value}</dd>
            </div>
          ))
        }
      </dl>
      {
        d.links.length > 0 && (
          <p class="case-links">
            {d.links.map((l) => (
              <a
                class="btn btn--small btn--outline"
                href={l.url}
                rel={isExternal(l.url) ? 'noopener' : undefined}
                target={isExternal(l.url) ? '_blank' : undefined}
              >
                {l.label}
                {isExternal(l.url) && <span aria-hidden="true"> ↗</span>}
                {isExternal(l.url) && <span class="sr-only"> (nouvel onglet)</span>}
              </a>
            ))}
          </p>
        )
      }
    </div>

    <div class="prose">
      <Content />
    </div>

    <nav class="pager" aria-label="Autres études de cas">
      {
        prev ? (
          <a href={url(`projets/${prev.id}/`)}>
            <span class="kicker">← Projet précédent</span>
            <strong>{prev.data.title}</strong>
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a class="next" href={url(`projets/${next.id}/`)}>
            <span class="kicker">Projet suivant →</span>
            <strong>{next.data.title}</strong>
          </a>
        )
      }
    </nav>
  </article>
</Base>
