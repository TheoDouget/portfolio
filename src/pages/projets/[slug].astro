---
import { render } from 'astro:content';
import { Picture, getImage } from 'astro:assets';
import Site from '../../layouts/Site.astro';
import { url, isExternal } from '../../lib/url.js';
import { getProjects, type Project } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: projects[i - 1] ?? null,
      next: projects[i + 1] ?? projects[0],
    },
  }));
}

interface Props {
  entry: Project;
  prev: Project | null;
  next: Project;
}

const { entry, prev, next } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const og = await getImage({ src: d.cover, width: 1200, format: 'jpg' });
// Photo plein écran en ouverture : l'image « hero » si elle existe, sinon la
// couverture quand c'est une photo. Sinon, bandeau clair avec l'image entière.
const heroImg = d.hero ?? (d.coverFit === 'cover' ? d.cover : null);
const heroPos = d.hero ? d.heroPosition : '50% 50%';

// Ligne de faits sous le titre
const facts = [d.kicker.split(' · ').slice(1).join(' · ') || d.context, d.period, d.team];

const meta = [
  { label: 'Rôle', value: d.role },
  { label: 'Cadre', value: d.context },
  { label: 'Statut', value: d.status },
  { label: 'Outils', value: d.tools.join(', ') },
];
---

<Site title={d.title} description={d.summary} image={og.src} type="article">
  <article>
    {
      heroImg ? (
        <header class="m-case-hero" data-hero>
          <Picture
            class="m-case-hero__media"
            src={heroImg}
            alt={d.heroAlt ?? d.coverAlt}
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            widths={[800, 1200, 1600, 2000].filter((w) => w <= heroImg.width)}
            sizes="100vw"
            loading="eager"
            fetchpriority="high"
            style={`object-position:${heroPos}`}
          />
          <div class="m-case-hero__text">
            <a class="m-back" href={url('projets/')}>
              ← Tous les projets
            </a>
            <p class="m-case-k">{d.year} · {d.domains.slice(0, 3).join(', ')}</p>
            <h1 class="wide">{d.title}</h1>
            <p class="m-case-facts">
              {facts.map((f) => (
                <span>{f}</span>
              ))}
            </p>
          </div>
        </header>
      ) : (
        <header class="m-case-hero m-case-hero--plain">
          <div class="m-case-hero__text">
            <a class="m-back" href={url('projets/')}>
              ← Tous les projets
            </a>
            <p class="m-case-k">{d.year} · {d.domains.slice(0, 3).join(', ')}</p>
            <h1 class="wide">{d.title}</h1>
            <p class="m-case-facts">
              {facts.map((f) => (
                <span>{f}</span>
              ))}
            </p>
          </div>
          <figure class="m-case-hero__figure">
            <Picture
              src={d.cover}
              alt={d.coverAlt}
              formats={['avif', 'webp']}
              fallbackFormat="png"
              widths={[600, 1000, 1400].filter((w) => w <= d.cover.width)}
              sizes="(min-width: 56rem) 50vw, 100vw"
              loading="eager"
              fetchpriority="high"
            />
          </figure>
        </header>
      )
    }

    <div class="m-case">
      <div class="m-case-intro">
        <p class="m-case-summary">{d.summary}</p>
        {
          d.keyFigures.length > 0 && (
            <dl class="m-figures">
              {d.keyFigures.map((f) => (
                <div>
                  <dt class="wide">{f.value}</dt>
                  <dd>{f.label}</dd>
                </div>
              ))}
            </dl>
          )
        }
        <dl class="m-case-meta">
          {
            meta.map((m) => (
              <div>
                <dt>{m.label}</dt>
                <dd>{m.value}</dd>
              </div>
            ))
          }
        </dl>
        {
          d.links.length > 0 && (
            <p class="m-case-links">
              {d.links.map((l) => (
                <a
                  class="m-btn"
                  href={l.url}
                  rel={isExternal(l.url) ? 'noopener' : undefined}
                  target={isExternal(l.url) ? '_blank' : undefined}
                >
                  {l.label}
                  {isExternal(l.url) && <span aria-hidden="true"> ↗</span>}
                  {isExternal(l.url) && <span class="sr-only"> (nouvel onglet)</span>}
                </a>
              ))}
            </p>
          )
        }
      </div>

      <div class="prose">
        <Content />
      </div>
    </div>

    <nav class="m-pager" aria-label="Autres études de cas">
      {
        prev ? (
          <a href={url(`projets/${prev.id}/`)}>
            <span>← Projet précédent</span>
            <strong class="wide">{prev.data.title}</strong>
          </a>
        ) : (
          <a href={url('projets/')}>
            <span>← Tous les projets</span>
            <strong class="wide">Projets</strong>
          </a>
        )
      }
      <a class="next" href={url(`projets/${next.id}/`)}>
        <span>Projet suivant →</span>
        <strong class="wide">{next.data.title}</strong>
      </a>
    </nav>
  </article>
</Site>
