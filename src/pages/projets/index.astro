---
import Base from '../../layouts/Base.astro';
import ProjectTile from '../../components/ProjectTile.astro';
import { site } from '../../data/site.js';
import { getProjects } from '../../lib/projects';

const projects = await getProjects();
---

<Base
  title="Projets"
  description="Études de cas de Théo Douget : drone autonome, robot tout-terrain pour le CNES, Anonym-IA, conception mécanique et simulation."
>
  <h1 class="page-title">Projets</h1>
  <p class="page-intro">
    Neuf études de cas, de la prépa au dernier stage. Chacune commence par le résultat, puis montre ce que j’ai fait
    moi-même, les décisions prises et ce qui n’a pas marché.
  </p>

  <ul class="collage">
    {projects.map((p, i) => <ProjectTile project={p} eager={i < 2} />)}
  </ul>

  <section class="section" aria-labelledby="archive">
    <div class="section-head">
      <h2 class="display" id="archive">Autres travaux</h2>
    </div>
    <table class="archive">
      <thead>
        <tr>
          <th scope="col">Année</th>
          <th scope="col">Travail</th>
          <th scope="col" class="hide-sm">Cadre</th>
          <th scope="col" class="hide-sm">Outils</th>
        </tr>
      </thead>
      <tbody>
        {
          site.archive.map((a) => (
            <tr>
              <td>{a.year}</td>
              <td>{a.title}</td>
              <td class="hide-sm muted">{a.kind}</td>
              <td class="hide-sm muted">{a.tools}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </section>
</Base>
