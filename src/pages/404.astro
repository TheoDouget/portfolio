---
import Site from '../layouts/Site.astro';
import { url } from '../lib/url.js';
---

<Site title="Page introuvable" noCanonical>
  <header class="m-page-head m-page-head--404">
    <div class="m-wrap">
      <p class="m-eyebrow">Erreur 404</p>
      <h1 class="wide">Page introuvable</h1>
      <p class="m-page-intro">Cette adresse n’existe pas ou a changé. Les projets et le contact sont à portée de clic.</p>
      <p class="m-case-links">
        <a class="m-btn" href={url('')}>Accueil</a>
        <a class="m-btn" href={url('projets/')}>Projets</a>
      </p>
    </div>
  </header>
</Site>
